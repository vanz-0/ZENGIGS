# ─── ZENGIGS Environment Variables ────────────────────────────────────────────
# Copy this file to .env and fill in your credentials.

# ─── SMTP (Cold Email Sender) ────────────────────────────────────────────────
# Recommended: Zoho Mail ($1/mo) or Google Workspace
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_EMAIL=your-email@zoho.com
SMTP_PASSWORD=your-app-password
SENDER_NAME=ZENGIGS

# ─── Lead Scraping (Apify) ──────────────────────────────────────────────────
APIFY_API_TOKEN=your-apify-token

# ─── Email Enrichment (Optional) ─────────────────────────────────────────────
ANYMAILFINDER_API_KEY=your-anymailfinder-key

# ─── Google Sheets (Optional) ────────────────────────────────────────────────
# Point this to your service account JSON or OAuth credentials file
GOOGLE_APPLICATION_CREDENTIALS=credentials.json

# ─── Supabase (Database) ─────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Debug ────────────────────────────────────────────────────────────────────
# Set to any value to enable verbose logging
# DEBUG=1

BREVO_API_KEY=your_brevo_api_key_here
